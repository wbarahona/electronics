{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ampage",
  "version": "../package.json",
  "identifier": "io.github.wbarahona.ampage",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ampage",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Electronics circuit simulator",
    "longDescription": "Draw circuits with European (IEC / DIN EN 60617) symbols and watch them run: a live simulator for learning electronics.",
    "fileAssociations": [
      {
        "ext": [
          "ampage"
        ],
        "name": "Ampage circuit",
        "description": "Ampage circuit",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.ampage+json",
        "contentTypes": [
          "io.github.wbarahona.ampage.circuit"
        ],
        "exportedType": {
          "identifier": "io.github.wbarahona.ampage.circuit",
          "conformsTo": [
            "public.data",
            "public.content"
          ]
        }
      }
    ],
    "copyright": "MIT License",
    "publisher": "wbarahona",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.tif",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 185
        },
        "applicationFolderPosition": {
          "x": 485,
          "y": 185
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
